# Copy this file to .openf1.env and fill in your OpenF1 login. Keep .openf1.env private.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Optional: your F1 account (F1 TV Pro) for FastF1 - recording the live-timing feed with full telemetry,
# and reading F1's archive for 2023 onwards. Or set FASTF1_AUTH_METHOD=browser to sign in in your browser instead.
F1_USERNAME=
F1_PASSWORD=
